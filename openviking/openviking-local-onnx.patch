+def detect_intra_op_threads() -> int:
+    """Thread count for the ONNX Runtime intra-op pool.
+
+    ORT sizes its pool from the HOST core count and ignores cgroup CPU
+    limits, which oversubscribes throttled containers. Honor the cgroup
+    quota (v2 then v1) when present; fall back to the host core count.
+    """
+    import os
+
+    host = os.cpu_count() or 1
+    try:
+        # cgroup v2: "<quota> <period>", quota "max" when unlimited.
+        with open("/sys/fs/cgroup/cpu.max") as fh:
+            parts = fh.read().split()
+        if parts and parts[0] != "max":
+            quota, period = int(parts[0]), int(parts[1])
+            if quota > 0 and period > 0:
+                return max(1, min(host, quota // period))
+    except Exception:
+        pass
+    try:
+        # cgroup v1
+        with open("/sys/fs/cgroup/cpu/cpu.cfs_quota_us") as fh:
+            quota = int(fh.read().strip())
+        with open("/sys/fs/cgroup/cpu/cpu.cfs_period_us") as fh:
+            period = int(fh.read().strip())
+        if quota > 0 and period > 0:
+            return max(1, min(host, quota // period))
+    except Exception:
+        pass
+    return host
 
 
