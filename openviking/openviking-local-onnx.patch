+    async def _rerank_scores_batched(
+        self,
+        query: str,
+        result_groups: List[List[Dict[str, Any]]],
+    ) -> List[List[Dict[str, Any]]]:
+        """Rerank every result group of a wave in a single provider call.
+
+        The per-child loop below previously awaited one rerank request per
+        group; on self-hosted endpoints each call is dominated by fixed HTTP
+        round-trip cost, so merging the groups into one batch removes that
+        multiplication without changing which documents are reranked.
+
+        Returns the same groups with ``_score`` replaced by rerank scores
+        where reranking applied (groups are returned unchanged on any
+        failure, mirroring ``_rerank_scores`` fallback semantics).
