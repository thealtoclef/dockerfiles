+            raise EmbeddingConfigurationError(
+                "Could not identify a sparse (per-token) output in the ONNX "
+                f"graph outputs {sorted(graph_outputs)}. This export does not "
+                "expose lexical weights, so hybrid retrieval cannot use it."
+            )
+        if "dense" in graph_outputs:
+            dense_name = "dense"
+        else:
+            dense_name = next(
+                (name for name in graph_outputs if name != sparse_name),
+                None,
+            )
+        if not dense_name:
+            raise EmbeddingConfigurationError(
+                f"Could not identify a dense output among {sorted(graph_outputs)}."
+            )
+        return dense_name, sparse_name
+
+    def _resolve_dimension(self) -> int:
+        """Dimension: explicit config > static graph shape > probe forward pass."""
+        dense_out = next(o for o in self._sess.get_outputs() if o.name == self._dense_out)
+        shape = dense_out.shape
+        if len(shape) == 2 and isinstance(shape[1], int) and shape[1] > 0:
+            discovered = int(shape[1])
+        else:
+            import numpy as np
+
+            probe_ids = np.zeros((1, 1), dtype="int64")
+            probe_mask = np.ones((1, 1), dtype="int64")
+            try:
+                probe = self._sess.run(
+                    [self._dense_out],
+                    {"input_ids": probe_ids, "attention_mask": probe_mask},
+                )[0]
+                discovered = int(np.asarray(probe).reshape(1, -1).shape[1])
+            except Exception as exc:
+                raise EmbeddingConfigurationError(
+                    "Could not determine the dense output dimension: the graph "
+                    f"shape is dynamic ({shape}) and a probe pass failed: {exc}. "
+                    "Set embedding.hybrid.dimension explicitly."
+                ) from exc
+        if self._requested_dimension and self._requested_dimension != discovered:
+            raise ValueError(
+                f"Local ONNX model '{self.model_name}' produces {discovered}-d dense "
+                f"vectors, but got dimension={self._requested_dimension}"
+            )
+        return discovered
+
+    # -- embed ----------------------------------------------------------------
+
+    def embed(self, content: "EmbeddingInput", is_query: bool = False) -> EmbedResult:
+        import numpy as np
+
+        text = extract_text_from_content(content)
+        enc = self._tokenizer(
+            [text],
+            padding=True,
+            truncation=True,
+            max_length=self._max_length,
+            return_tensors="np",
+        )
+        dense, sparse = self._sess.run(
+            [self._dense_out, self._sparse_out],
+            {
+                "input_ids": enc["input_ids"].astype("int64"),
+                "attention_mask": enc["attention_mask"].astype("int64"),
+            },
+        )
+
+        # dense: (B, dim) — L2-normalize here if the export does not.
+        dense_row = np.asarray(dense[0], dtype="float32").reshape(-1)
+        norm = float(np.linalg.norm(dense_row))
+        if norm > 0:
+            dense_row = dense_row / norm
+        dense_vec = [float(x) for x in dense_row]
