+        self.cache_dir = cache_dir or DEFAULT_LOCAL_MODEL_CACHE_DIR
+        self._dimension = dimension or int(spec["dimension"])
+        if self._dimension != int(spec["dimension"]):
+            raise ValueError(
+                f"Local hybrid ONNX model '{model_name}' has fixed dimension "
+                f"{spec['dimension']}, but got dimension={self._dimension}"
+            )
+
