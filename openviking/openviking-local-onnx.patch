+# Copyright (c) 2026 Beijing Volcano Engine Technology Co., Ltd.
+# SPDX-License-Identifier: AGPL-3.0
+"""Local ONNX cross-encoder reranker via onnxruntime (CPU)."""
+
+from __future__ import annotations
+
+import importlib
+import math
+from pathlib import Path
+from typing import Any, List, Optional
+
+import numpy as np
+
+from openviking.models.embedder.local_embedders import detect_intra_op_threads
+from openviking.models.rerank.base import RerankBase
+from openviking.storage.errors import EmbeddingConfigurationError
+from openviking_cli.utils import get_logger
+
+logger = get_logger(__name__)
+
+DEFAULT_LOCAL_RERANK_CACHE_DIR = "~/.cache/openviking/models"
+
+
+class LocalONNXRerankClient(RerankBase):
+    """Cross-encoder reranker backed by a local ONNX model via ONNX Runtime (CPU).
+
+    Works with any ONNX sequence-classification export that produces a single
+    relevance score per (query, document) pair — nothing is keyed on the
+    model name. The session file is discovered from the model directory
+    (``*.onnx``) and the score output is identified by its per-pair shape
+    rather than by name. The context window comes from the tokenizer's
+    declared maximum; the runtime-level ``rerank.max_input_tokens`` budget
+    bounds each pair before the tokenizer sees it.
+
+    Output is one score per pair, passed through a sigmoid to 0..1. Pairs are
+    scored one at a time so memory stays bounded even for long documents on
+    small CPU-only containers.
+    """
+
+    def __init__(
+        self,
+        model_name: str = "local-onnx-rerank",
+        model_path: Optional[str] = None,
+        cache_dir: Optional[str] = None,
+        config: Optional[Any] = None,
+    ):
+        super().__init__()
+        self.model_name = model_name
+        self.provider = "local"
+        self.cache_dir = cache_dir or DEFAULT_LOCAL_RERANK_CACHE_DIR
+        self.config = config or {}
+
+        self._model_dir = self._resolve_model_dir(model_path)
+        self._ort = self._import_ort()
+        self._sess = self._load_session()
+        self._tokenizer = self._load_tokenizer()
+        self._max_length = self._resolve_max_length()
+        self._score_out = self._discover_score_output()
+
+    # -- setup ---------------------------------------------------------------
+
+    def _import_ort(self):
+        try:
+            module = importlib.import_module("onnxruntime")
+            return module
+        except ImportError as exc:
+            raise EmbeddingConfigurationError(
+                "Local ONNX reranking requires 'onnxruntime'. "
+                "Install it or use the custom dockerfiles/openviking image."
+            ) from exc
+
+    def _resolve_model_dir(self, model_path: Optional[str]) -> Path:
+        # model_path is required: models are provisioned outside the app.
+        if not model_path:
+            raise EmbeddingConfigurationError(
+                "Local ONNX reranking requires 'model_path' pointing at a "
+                "pre-downloaded ONNX model directory. Set rerank.model_path in ov.conf."
+            )
+        resolved = Path(model_path).expanduser().resolve()
+        if not resolved.is_dir():
+            raise EmbeddingConfigurationError(
+                f"Local ONNX rerank model directory not found: {resolved}"
+            )
+        return resolved
+
+    def _find_session_file(self) -> Path:
+        """Locate the ONNX session file: the conventional name, else the sole
+        ``*.onnx`` file in the model directory."""
+        conventional = self._model_dir / "model.onnx"
+        if conventional.exists():
+            return conventional
+        candidates = sorted(
+            p for p in self._model_dir.iterdir()
+            if p.is_file() and p.suffix.lower() == ".onnx"
+        )
+        if not candidates:
+            raise EmbeddingConfigurationError(
+                f"No .onnx session file found in {self._model_dir}."
+            )
+        if len(candidates) > 1:
+            names = ", ".join(p.name for p in candidates)
+            raise EmbeddingConfigurationError(
+                f"Multiple .onnx files in {self._model_dir} ({names}); keep one "
+                "per model directory."
+            )
+        return candidates[0]
+
+    def _load_session(self):
+        path = self._find_session_file()
+        try:
+            session_options = self._ort.SessionOptions()
+            session_options.intra_op_num_threads = detect_intra_op_threads()
+            return self._ort.InferenceSession(
+                str(path),
+                sess_options=session_options,
+                providers=["CPUExecutionProvider"],
+            )
+        except Exception as exc:
+            raise EmbeddingConfigurationError(
+                f"Failed to load ONNX session from {path}: {exc}"
+            ) from exc
+
+    def _load_tokenizer(self):
+        try:
+            from transformers import AutoTokenizer
+        except ImportError as exc:
+            raise EmbeddingConfigurationError(
+                "Local ONNX reranking requires 'transformers' for the tokenizer. "
+                "Install it or use the custom dockerfiles/openviking image."
+            ) from exc
+        # HF model repos commonly keep tokenizer files under tokenizer_hf/
+        # (bge exports) or at the root; prefer the conventional subdir, then
+        # the directory root.
+        for candidate in (self._model_dir / "tokenizer_hf", self._model_dir):
+            if (candidate / "tokenizer_config.json").exists() or (
+                candidate / "tokenizer.json"
+            ).exists():
+                try:
+                    return AutoTokenizer.from_pretrained(str(candidate))
+                except Exception as exc:
+                    raise EmbeddingConfigurationError(
+                        f"Failed to load tokenizer from {candidate}: {exc}"
+                    ) from exc
+        raise EmbeddingConfigurationError(
+            f"No tokenizer files found in {self._model_dir} (looked in tokenizer_hf/ "
+            "and the directory root)."
+        )
+
+    def _resolve_max_length(self) -> int:
+        """Context window: the tokenizer's declared maximum."""
+        declared = getattr(self._tokenizer, "model_max_length", None)
+        if isinstance(declared, int) and 0 < declared <= 8192:
+            return declared
+        return 512
+
+    def _discover_score_output(self) -> str:
+        """Bind the per-pair score output: the conventional name, or the
+        unique per-sequence (rank-2, unit-dim) output."""
+        graph_outputs = {o.name: o for o in self._sess.get_outputs()}
+        if "logits" in graph_outputs:
+            return "logits"
+        per_sequence = [
+            name
+            for name, out in graph_outputs.items()
+            if len(out.shape) == 2
+            and (isinstance(out.shape[1], int) or out.shape[1] in (None, "?"))
+            and (not isinstance(out.shape[1], int) or out.shape[1] == 1)
+        ]
+        if len(per_sequence) == 1:
+            return per_sequence[0]
+        raise EmbeddingConfigurationError(
+            "Could not identify the score output in the ONNX graph outputs "
+            f"{sorted(graph_outputs)} (expected exactly one (batch, 1) sequence-"
+            "classification output)."
+        )
+
+    # -- rerank ---------------------------------------------------------------
+
+    def rerank_batch(self, query: str, documents: List[str]) -> Optional[List[float]]:
+        """Return a relevance score per document (0..1, sigmoid of the score).
+
+        Args:
+            query: Query text
+            documents: List of document texts to score
+
+        Returns:
+            List[float] of scores in the same order as ``documents``, or None
+            on failure so the caller falls back to vector scores.
+        """
+        if not documents:
+            return []
+        try:
+            scores = []
+            for doc in documents:
+                # Cross-encoder pair encoding: positional (text, text_pair) so
+                # query and doc become ONE SEP-joined sequence. Passing a list
+                # [query, doc] would tokenize them as two unrelated sequences.
+                enc = self._tokenizer(
+                    query,
+                    doc,
+                    padding=True,
+                    truncation=True,
+                    max_length=self._max_length,
+                    return_tensors="np",
+                )
+                inputs = {
+                    k: v.astype("int64")
+                    for k, v in enc.items()
+                    if k in {"input_ids", "attention_mask", "token_type_ids"}
+                }
+                raw = self._sess.run([self._score_out], inputs)[0]
+                # sequence classification -> single score per pair -> 0..1
+                score = float(np.asarray(raw, dtype="float32").reshape(-1)[0])
+                scores.append(1.0 / (1.0 + math.exp(-score)))
+                self.update_token_usage(
+                    model_name=self.model_name,
+                    provider="local",
+                    prompt_tokens=int(enc["input_ids"].size),
+                    completion_tokens=0,
+                )
+            logger.debug("[LocalONNXRerankClient] Reranked %d documents", len(documents))
+            return scores
+        except Exception as e:
+            logger.error(f"[LocalONNXRerankClient] Rerank failed: {e}")
+            return None
+
+    def close(self):
+        # ONNX Runtime sessions are closed on GC; nothing to release eagerly.
+        pass
+
+    @classmethod
+    def from_config(cls, config) -> Optional["LocalONNXRerankClient"]:
+        """Create LocalONNXRerankClient from RerankConfig (provider='local')."""
+        if not config or not config.is_available():
+            return None
+        return cls(
+            model_name=config.model or "local-onnx-rerank",
+            model_path=config.model_path,
+            cache_dir=config.cache_dir,
+            config=config,
+        )
