+        # the attention mask, drop CLS/SEP/stopword tokens, then collapse
+        # duplicate terms. Emit Dict[str, float].
+        tokens = self._tokenizer.convert_ids_to_tokens(enc["input_ids"][0])
+        weights = np.maximum(0.0, np.asarray(sparse[0], dtype="float32").reshape(-1))
+        weights[~enc["attention_mask"][0].astype(bool)] = 0.0
+        sparse_map: Dict[str, float] = {}
+        for tok_id, term, w in zip(enc["input_ids"][0], tokens, weights):
+            tid = int(tok_id)
+            if tid in LOCAL_HYBRID_ONNX_STOPWORD_IDS:
+                continue
+            if w <= 0.0:
+                continue
+            if not term or term.startswith("▁"):
+                term = term.lstrip("▁")
+            if not term:
+                continue
+            sparse_map[term] = sparse_map.get(term, 0.0) + float(w)
+
+        self.update_token_usage(
+            model_name=self.model_name,
+            provider="local",
+            prompt_tokens=int(enc["input_ids"].size),
+            completion_tokens=0,
+        )
+        return EmbedResult(dense_vector=dense_vec, sparse_vector=sparse_map or None)
+
+    def get_dimension(self) -> int:
+        return self._dimension
+
+    def close(self):
+        # ONNX Runtime sessions are closed on GC; nothing to release eagerly.
+        pass
