+# Copyright (c) 2026 Beijing Volcano Engine Technology Co., Ltd.
+# SPDX-License-Identifier: AGPL-3.0
+"""BGE-M3 hybrid embedder backed by a self-hosted bge-m3-embedding-server.
+
+The server (Rust/Axum + ONNX Runtime, Apache-2.0) serves ``BAAI/bge-m3`` with
+its native dense and sparse heads. Its ``/v1/embeddings:both`` endpoint runs
+one forward pass per text and returns both representations, which is why this
+is a single hybrid embedder rather than a CompositeHybridEmbedder over two
+providers.
+
+Sparse weights are returned keyed by vocabulary token id (as strings). The
+local vector store hashes sparse term strings, so any consistent keying works;
+string token ids are lossless and require no tokenizer on the client side.
+"""
+
+from typing import Any, Dict, List, Optional
+
+import httpx
+
+from openviking.models.embedder.base import (
+    EmbeddingInput,
+    HybridEmbedderBase,
+    EmbedResult,
+    extract_text_from_content,
+)
+from openviking.utils.async_client_cache import LoopScopedAsyncClientCache
+from openviking_cli.utils import get_logger
+
+logger = get_logger(__name__)
+
+BGE_M3_DIMENSION = 1024
+DEFAULT_BGE_M3_API_BASE = "http://localhost:8081"
+DEFAULT_BGE_M3_MODEL = "bge-m3"
+
+
+class BGEM3HybridEmbedder(HybridEmbedderBase):
+    """Hybrid embedder calling a bge-m3-embedding-server's combined endpoint.
+
+    The server always runs BGE-M3 (the ``model`` request field is accepted for
+    OpenAI compatibility and ignored); it is still sent so the provider works
+    against any future multi-model deployment of the same wire format.
+    """
+
+    def __init__(
+        self,
+        model_name: str = DEFAULT_BGE_M3_MODEL,
+        api_key: Optional[str] = None,
+        api_base: Optional[str] = None,
+        dimension: Optional[int] = None,
+        config: Optional[Dict[str, Any]] = None,
+    ):
+        super().__init__(model_name, config)
+        self.provider = "bge-m3"
+
+        self.api_base = (api_base or DEFAULT_BGE_M3_API_BASE).rstrip("/")
+        self._dimension = dimension or BGE_M3_DIMENSION
+        if self._dimension != BGE_M3_DIMENSION:
+            raise ValueError(
+                f"BGE-M3 has a fixed dimension of {BGE_M3_DIMENSION}, "
+                f"but got dimension={self._dimension}"
+            )
+
+        headers = {"Content-Type": "application/json"}
+        if api_key:
+            headers["Authorization"] = f"Bearer {api_key}"
+        self._client = httpx.Client(base_url=self.api_base, headers=headers, timeout=60.0)
+        self._async_client_cache = LoopScopedAsyncClientCache()
+
+    def _call_api(self, texts: List[str]) -> List[Dict[str, Any]]:
+        resp = self._client.post(
+            "/v1/embeddings:both",
+            json={"input": texts, "model": self.model_name},
+        )
+        resp.raise_for_status()
+        return resp.json()["data"]
+
+    async def _call_api_async(self, texts: List[str]) -> List[Dict[str, Any]]:
+        client = self._async_client_cache.get(
+            lambda: httpx.AsyncClient(base_url=self.api_base, headers=self._client.headers, timeout=60.0)
+        )
+        resp = await client.post(
+            "/v1/embeddings:both",
+            json={"input": texts, "model": self.model_name},
+        )
+        resp.raise_for_status()
+        return resp.json()["data"]
+
+    @staticmethod
+    def _to_result(entry: Dict[str, Any]) -> EmbedResult:
+        sparse = entry["sparse_values"]
+        sparse_vector = {
+            str(idx): float(weight) for idx, weight in zip(sparse["indices"], sparse["values"])
+        }
+        return EmbedResult(
+            dense_vector=[float(x) for x in entry["embedding"]],
+            sparse_vector=sparse_vector or None,
+        )
+
+    def embed(self, content: "EmbeddingInput", is_query: bool = False) -> EmbedResult:
+        text = extract_text_from_content(content)
+        try:
+            data = self._run_with_retry(
+                lambda: self._call_api([text]),
+                logger=logger,
+                operation_name="bge-m3 embedding",
+            )
+            result = self._to_result(data[0])
+        except httpx.HTTPStatusError as exc:
+            raise RuntimeError(
+                f"bge-m3 server error: {exc.response.status_code} {exc.response.text}"
+            ) from exc
+        except Exception as exc:
+            raise RuntimeError(f"bge-m3 embedding failed: {exc}") from exc
+
+        self.update_token_usage(
+            model_name=self.model_name,
+            provider=self.provider,
+            prompt_tokens=self._estimate_tokens(text),
+            completion_tokens=0,
+        )
+        return result
+
+    async def embed_async(self, content: "EmbeddingInput", is_query: bool = False) -> EmbedResult:
+        text = extract_text_from_content(content)
+
+        async def _call() -> EmbedResult:
+            data = await self._call_api_async([text])
+            return self._to_result(data[0])
+
+        try:
+            result = await self._run_with_async_retry(
+                _call,
+                logger=logger,
+                operation_name="bge-m3 async embedding",
+            )
+        except httpx.HTTPStatusError as exc:
+            raise RuntimeError(
+                f"bge-m3 server error: {exc.response.status_code} {exc.response.text}"
+            ) from exc
+        except Exception as exc:
+            raise RuntimeError(f"bge-m3 embedding failed: {exc}") from exc
+
+        self.update_token_usage(
+            model_name=self.model_name,
+            provider=self.provider,
+            prompt_tokens=self._estimate_tokens(text),
+            completion_tokens=0,
+        )
+        return result
+
+    def get_dimension(self) -> int:
+        return self._dimension
+
+    def close(self):
+        self._client.close()
+        self._async_client_cache.close_all_with_aclose()
