@@ -0,0 +1,175 @@
+# Copyright (c) 2026 Beijing Volcano Engine Technology Co., Ltd.
+# SPDX-License-Identifier: AGPL-3.0
+"""Local ONNX cross-encoder reranker via onnxruntime (CPU)."""
+
+from __future__ import annotations
+
+import importlib
+import math
+from pathlib import Path
+from typing import Any, List, Optional
+
+from openviking.models.rerank.base import RerankBase
+from openviking.storage.errors import EmbeddingConfigurationError
+from openviking_cli.utils import get_logger
+
+logger = get_logger(__name__)
+
+DEFAULT_LOCAL_RERANK_CACHE_DIR = "~/.cache/openviking/models"
+# Most-adopted CPU-tagged ONNX export of bge-reranker-v2-m3 (sequence
+# classification, fp32, ~2.2 GB). Exposes a single relevance logit per pair.
+DEFAULT_LOCAL_RERANK_REPO = "a-ivanovitch/bge-reranker-v2-m3-onnx"
+DEFAULT_LOCAL_RERANK_SESS_FILE = "model_fp32.onnx"
+DEFAULT_LOCAL_RERANK_MODEL = "bge-reranker-v2-m3-onnx"
+# The base model supports 8192-token context; keep the full window like the
+# embedder (the ONNX export does not cap it at a shorter value).
+LOCAL_RERANK_MAX_LENGTH = 8192
+
+
+class LocalONNXRerankClient(RerankBase):
+    """Cross-encoder reranker backed by a local ONNX model via ONNX Runtime (CPU).
+
+    One ONNX session scores a query against a batch of documents. Output is a
+    single logit per (query, doc) pair, converted to a 0..1 relevance score via
+    sigmoid. Pairs are scored one at a time so memory stays bounded even for
+    long documents on small CPU-only containers.
+    """
+
+    def __init__(
+        self,
+        model_name: str = DEFAULT_LOCAL_RERANK_MODEL,
+        model_path: Optional[str] = None,
+        cache_dir: Optional[str] = None,
+        config: Optional[Any] = None,
+    ):
+        super().__init__()
+        self.model_name = model_name
+        self.provider = "local"
+        self.cache_dir = cache_dir or DEFAULT_LOCAL_RERANK_CACHE_DIR
+        self.config = config or {}
+
+        self._model_dir = self._resolve_model_dir(model_path)
+        self._ort = self._import_ort()
+        self._sess = self._load_session()
+        self._tokenizer = self._load_tokenizer()
+
+    # -- setup ---------------------------------------------------------------
+
+    def _import_ort(self):
+        try:
+            module = importlib.import_module("onnxruntime")
+            return module
+        except ImportError as exc:
+            raise EmbeddingConfigurationError(
+                "Local ONNX reranking requires 'onnxruntime'. "
+                "Install it or use the custom dockerfiles/openviking image."
+            ) from exc
+
+    def _resolve_model_dir(self, model_path: Optional[str]) -> Path:
+        # model_path is required: models are baked into the image at build time.
+        if not model_path:
+            raise EmbeddingConfigurationError(
+                "Local ONNX reranking requires 'model_path' pointing at a "
+                "pre-downloaded ONNX model directory (baked into the image at build). "
+                "Set rerank.model_path in ov.conf."
+            )
+        resolved = Path(model_path).expanduser().resolve()
+        if not (resolved / DEFAULT_LOCAL_RERANK_SESS_FILE).exists():
+            raise EmbeddingConfigurationError(
+                f"Local ONNX rerank model dir missing session file: {resolved}"
+            )
+        return resolved
+
+    def _load_session(self):
+        try:
+            return self._ort.InferenceSession(
+                str(self._model_dir / DEFAULT_LOCAL_RERANK_SESS_FILE),
+                providers=["CPUExecutionProvider"],
+            )
+        except Exception as exc:
+            raise EmbeddingConfigurationError(f"Failed to load ONNX session: {exc}") from exc
+
+    def _load_tokenizer(self):
+        try:
+            from transformers import AutoTokenizer
+        except ImportError as exc:
+            raise EmbeddingConfigurationError(
+                "Local ONNX reranking requires 'transformers' for the tokenizer. "
+                "Install it or use the custom dockerfiles/openviking image."
+            ) from exc
+        # Both HF model repos keep all tokenizer files under tokenizer_hf/,
+        # not at the repo root — load from there.
+        tokenizer_dir = self._model_dir / "tokenizer_hf"
+        try:
+            return AutoTokenizer.from_pretrained(str(tokenizer_dir))
+        except Exception as exc:
+            raise EmbeddingConfigurationError(
+                f"Failed to load tokenizer from {tokenizer_dir}: {exc}"
+            ) from exc
+
+    # -- rerank ---------------------------------------------------------------
+
+    def rerank_batch(self, query: str, documents: List[str]) -> Optional[List[float]]:
+        """Return a relevance score per document (0..1, sigmoid of the logit).
+
+        Args:
+            query: Query text
+            documents: List of document texts to score
+
+        Returns:
+            List[float] of scores in the same order as ``documents``, or None
+            on failure so the caller falls back to vector scores.
+        """
+        if not documents:
+            return []
+        try:
+            scores = []
+            for doc in documents:
+                # Cross-encoder pair encoding: positional (text, text_pair) so
+                # query and doc become ONE SEP-joined sequence. Passing a list
+                # [query, doc] would tokenize them as two unrelated sequences.
+                enc = self._tokenizer(
+                    query,
+                    doc,
+                    padding=True,
+                    truncation=True,
+                    max_length=LOCAL_RERANK_MAX_LENGTH,
+                    return_tensors="np",
+                )
+                logits, = self._sess.run(
+                    ["logits"],
+                    {
+                        "input_ids": enc["input_ids"].astype("int64"),
+                        "attention_mask": enc["attention_mask"].astype("int64"),
+                    },
+                )
+                # sequence classification -> single logit -> sigmoid to 0..1
+                score = float(logits.reshape(-1)[0])
+                scores.append(1.0 / (1.0 + math.exp(-score)))
+                self.update_token_usage(
+                    model_name=self.model_name,
+                    provider="local",
+                    prompt_tokens=int(enc["input_ids"].size),
+                    completion_tokens=0,
+                )
+            logger.debug("[LocalONNXRerankClient] Reranked %d documents", len(documents))
+            return scores
+        except Exception as e:
+            logger.error(f"[LocalONNXRerankClient] Rerank failed: {e}")
+            return None
+
+    def close(self):
+        # ONNX Runtime sessions are closed on GC; nothing to release eagerly.
+        pass
+
+    @classmethod
+    def from_config(cls, config) -> Optional["LocalONNXRerankClient"]:
+        """Create LocalONNXRerankClient from RerankConfig (provider='local')."""
+        if not config or not config.is_available():
+            return None
+        return cls(
+            model_name=config.model or DEFAULT_LOCAL_RERANK_MODEL,
+            model_path=config.model_path,
+            cache_dir=config.cache_dir,
+            config=config,
+        )
