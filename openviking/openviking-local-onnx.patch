+class LocalONNXHybridEmbedder(HybridEmbedderBase):
+    """Dense + sparse hybrid embedder backed by a local ONNX model (CPU).
+
+    Works with any ONNX export whose session exposes a dense output and a
+    per-token sparse lexical-weight output (shape ``(batch, seq)`` or
+    ``(batch, seq, 1)``); nothing is keyed on the model name. The output
+    names, dense dimension, context window (tokenizer's declared maximum),
+    and the special-token ids stripped from sparse weights are all
+    discovered from the model artifacts at load time.
+
+    Sparse output is emitted as ``{term: weight}`` so it plugs straight into
+    the local vector store's ``sparse_raw_terms`` / ``sparse_values`` and its
+    native dense+sparse fusion.
+    """
+
+    def __init__(
+        self,
+        model_name: str = "local-onnx-hybrid",
+        model_path: Optional[str] = None,
+        cache_dir: Optional[str] = None,
+        dimension: Optional[int] = None,
+        config: Optional[Dict[str, Any]] = None,
+    ):
+        runtime_config = dict(config or {})
+        runtime_config.setdefault("provider", "local")
+        super().__init__(model_name, runtime_config)
+
+        self.cache_dir = cache_dir or DEFAULT_LOCAL_MODEL_CACHE_DIR
+        self._requested_dimension = dimension
+
+        self._model_dir = self._resolve_model_dir(model_path)
+        self._ort = self._import_ort()
+        self._sess = self._load_session()
+        self._tokenizer = self._load_tokenizer()
+        self._max_length = self._resolve_max_length()
+        self._dense_out, self._sparse_out = self._discover_outputs()
+
+        # Dimension: explicit config wins; else discovered from the dense
+        # output shape (static) or a one-token probe pass (dynamic shape).
+        self._dimension = self._resolve_dimension()
+
+    # -- setup ---------------------------------------------------------------
+
+    def _import_ort(self):
+        try:
+            module = importlib.import_module("onnxruntime")
+            return module
+        except ImportError as exc:
+            raise EmbeddingConfigurationError(
+                "Local hybrid ONNX embedding requires 'onnxruntime'. "
+                "Install it with: pip install 'openviking[local-hybrid-onnx]' or "
+                "use the custom dockerfiles/openviking image."
+            ) from exc
+
+    def _resolve_model_dir(self, model_path: Optional[str]) -> Path:
+        # model_path is required: models are provisioned outside the app.
+        if not model_path:
+            raise EmbeddingConfigurationError(
+                "Local hybrid ONNX embedding requires 'model_path' pointing at a "
+                "pre-downloaded ONNX model directory. "
+                "Set embedding.hybrid.model_path in ov.conf."
+            )
+        resolved = Path(model_path).expanduser().resolve()
+        if not resolved.is_dir():
+            raise EmbeddingConfigurationError(
+                f"Local hybrid ONNX model directory not found: {resolved}"
+            )
+        return resolved
+
+    def _find_session_file(self) -> Path:
+        """Locate the ONNX session file: the conventional name, else the sole
+        ``*.onnx`` file in the model directory."""
+        conventional = self._model_dir / DEFAULT_ONNX_SESSION_FILE
+        if conventional.exists():
+            return conventional
+        candidates = sorted(
+            p for p in self._model_dir.iterdir()
+            if p.is_file() and p.suffix.lower() in ONNX_SESSION_FILE_SUFFIXES
+        )
+        if not candidates:
+            raise EmbeddingConfigurationError(
+                f"No .onnx session file found in {self._model_dir}."
+            )
+        if len(candidates) > 1:
+            names = ", ".join(p.name for p in candidates)
+            raise EmbeddingConfigurationError(
+                f"Multiple .onnx files in {self._model_dir} ({names}); keep one "
+                "per model directory."
+            )
+        return candidates[0]
+
+    def _load_session(self):
+        path = self._find_session_file()
+        try:
+            session_options = self._ort.SessionOptions()
+            session_options.intra_op_num_threads = detect_intra_op_threads()
+            return self._ort.InferenceSession(
+                str(path),
+                sess_options=session_options,
+                providers=["CPUExecutionProvider"],
+            )
+        except Exception as exc:
+            raise EmbeddingConfigurationError(
+                f"Failed to load ONNX session from {path}: {exc}"
+            ) from exc
+
+    def _load_tokenizer(self):
+        try:
+            from transformers import AutoTokenizer
+        except ImportError as exc:
+            raise EmbeddingConfigurationError(
+                "Local hybrid ONNX embedding requires 'transformers' for the tokenizer. "
+                "Install it or use the custom dockerfiles/openviking image."
+            ) from exc
+        # HF model repos commonly keep tokenizer files under tokenizer_hf/
+        # (bge exports) or at the root; prefer the conventional subdir, then
+        # the directory root.
+        for candidate in (self._model_dir / "tokenizer_hf", self._model_dir):
+            if (candidate / "tokenizer_config.json").exists() or (
+                candidate / "tokenizer.json"
+            ).exists():
+                try:
+                    return AutoTokenizer.from_pretrained(str(candidate))
+                except Exception as exc:
+                    raise EmbeddingConfigurationError(
+                        f"Failed to load tokenizer from {candidate}: {exc}"
+                    ) from exc
+        raise EmbeddingConfigurationError(
+            f"No tokenizer files found in {self._model_dir} (looked in tokenizer_hf/ "
+            "and the directory root)."
+        )
+
+    def _resolve_max_length(self) -> int:
+        """Context window: the tokenizer's declared maximum."""
+        declared = getattr(self._tokenizer, "model_max_length", None)
+        if isinstance(declared, int) and 0 < declared <= ONNX_MAX_LENGTH_CAP:
+            return declared
+        return ONNX_MAX_LENGTH_FALLBACK
+
+    def _discover_outputs(self):
+        """Bind the dense and sparse output names from the graph.
+
+        A sparse output is a graph output whose shape is per-token (rank >= 2
+        with a sequence axis) rather than a flat per-sequence vector.
+        """
+        graph_outputs = {o.name: o for o in self._sess.get_outputs()}
+        dense_name = None
+        sparse_name = None
+
+        # Prefer the conventional name, else the first per-token output.
+        if "sparse" in graph_outputs:
+            sparse_name = "sparse"
+        else:
+            for name, out in graph_outputs.items():
+                shape = out.shape
+                if len(shape) >= 2 and (
+                    isinstance(shape[1], int) or (shape[1] in (None, "?", "seq_len"))
+                ):
+                    if len(shape) == 2 and isinstance(shape[-1], int):
+                        # (batch, dim) looks like a dense vector output.
+                        continue
+                    sparse_name = name
+                    break
+        if not sparse_name:
+            raise EmbeddingConfigurationError(
+                "Could not identify a sparse (per-token) output in the ONNX "
+                f"graph outputs {sorted(graph_outputs)}. This export does not "
+                "expose lexical weights, so hybrid retrieval cannot use it."
+            )
+        if "dense" in graph_outputs:
+            dense_name = "dense"
+        else:
+            dense_name = next(
+                (name for name in graph_outputs if name != sparse_name),
+                None,
+            )
+        if not dense_name:
+            raise EmbeddingConfigurationError(
+                f"Could not identify a dense output among {sorted(graph_outputs)}."
+            )
+        return dense_name, sparse_name
+
+    def _resolve_dimension(self) -> int:
+        """Dimension: explicit config > static graph shape > probe forward pass."""
+        dense_out = next(o for o in self._sess.get_outputs() if o.name == self._dense_out)
+        shape = dense_out.shape
+        if len(shape) == 2 and isinstance(shape[1], int) and shape[1] > 0:
+            discovered = int(shape[1])
+        else:
+            import numpy as np
+
+            probe_ids = np.zeros((1, 1), dtype="int64")
+            probe_mask = np.ones((1, 1), dtype="int64")
+            try:
+                probe = self._sess.run(
+                    [self._dense_out],
+                    {"input_ids": probe_ids, "attention_mask": probe_mask},
+                )[0]
+                discovered = int(np.asarray(probe).reshape(1, -1).shape[1])
+            except Exception as exc:
+                raise EmbeddingConfigurationError(
+                    "Could not determine the dense output dimension: the graph "
+                    f"shape is dynamic ({shape}) and a probe pass failed: {exc}. "
+                    "Set embedding.hybrid.dimension explicitly."
+                ) from exc
+        if self._requested_dimension and self._requested_dimension != discovered:
+            raise ValueError(
+                f"Local ONNX model '{self.model_name}' produces {discovered}-d dense "
+                f"vectors, but got dimension={self._requested_dimension}"
+            )
+        return discovered
+
+    # -- embed ----------------------------------------------------------------
+
+    def embed(self, content: "EmbeddingInput", is_query: bool = False) -> EmbedResult:
+        import numpy as np
+
+        text = extract_text_from_content(content)
+        enc = self._tokenizer(
+            [text],
+            padding=True,
+            truncation=True,
+            max_length=self._max_length,
+            return_tensors="np",
+        )
+        dense, sparse = self._sess.run(
+            [self._dense_out, self._sparse_out],
+            {
+                "input_ids": enc["input_ids"].astype("int64"),
+                "attention_mask": enc["attention_mask"].astype("int64"),
+            },
+        )
+
+        # dense: (B, dim) — L2-normalize here if the export does not.
+        dense_row = np.asarray(dense[0], dtype="float32").reshape(-1)
+        norm = float(np.linalg.norm(dense_row))
+        if norm > 0:
+            dense_row = dense_row / norm
+        dense_vec = [float(x) for x in dense_row]
+
+        # sparse: (B, seq) or (B, seq, 1) token weights -> ReLU, zero out
+        # padded positions via the attention mask, drop the tokenizer's
+        # special tokens, then max-pool duplicate tokens (BGE-M3's reference
+        # sparse behavior). Keys are vocab token ids as strings — the same
+        # keying as the remote OpenAI-compatible hybrid provider, so a
+        # collection indexed with one stays sparse-compatible with the other
+        # under failover.
+        weights = np.maximum(0.0, np.asarray(sparse[0], dtype="float32").reshape(-1))
+        weights[~enc["attention_mask"][0].astype(bool)] = 0.0
+        special_ids = self._special_token_ids()
+        sparse_map: Dict[str, float] = {}
+        for tok_id, w in zip(enc["input_ids"][0], weights):
+            tid = int(tok_id)
+            if tid in special_ids:
+                continue
+            if w <= 0.0:
+                continue
+            key = str(tid)
+            prev = sparse_map.get(key)
+            if prev is None or float(w) > prev:
+                sparse_map[key] = float(w)
+
+        self.update_token_usage(
+            model_name=self.model_name,
+            provider="local",
+            prompt_tokens=int(enc["input_ids"].size),
+            completion_tokens=0,
+        )
+        return EmbedResult(dense_vector=dense_vec, sparse_vector=sparse_map or None)
+
+    def _special_token_ids(self) -> frozenset:
+        """Special-token ids from the tokenizer (CLS/SEP/pad/unk etc.), used
+        to strip noise tokens from sparse lexical weights."""
+        ids = set()
+        for attr in (
+            "cls_token_id",
+            "sep_token_id",
+            "pad_token_id",
+            "unk_token_id",
+            "bos_token_id",
+            "eos_token_id",
+            "mask_token_id",
+        ):
+            value = getattr(self._tokenizer, attr, None)
+            if isinstance(value, int):
+                ids.add(value)
+        return frozenset(ids)
+
+    def get_dimension(self) -> int:
+        return self._dimension
+
+    def close(self):
+        # ONNX Runtime sessions are closed on GC; nothing to release eagerly.
+        pass
